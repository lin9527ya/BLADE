# Docker 部署配置（复制为 .env）
BLADE_TAG=latest
POSTGRES_USER=blade
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=blade

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BLADE_LLM_PROVIDER=
BLADE_LLM_MODEL=
BLADE_LLM_BASE_URL=
BLADE_LLM_PROXY=

# 附带自建 SearXNG 容器（可选覆盖镜像源前缀、监听端口与出海代理）
SEARXNG_IMAGE_PREFIX=docker.io/
SEARXNG_TAG=latest
SEARXNG_PORT=8888
SEARXNG_HTTP_PROXY=
SEARXNG_HTTPS_PROXY=
